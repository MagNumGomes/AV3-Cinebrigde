{
  "name": "cinebridge-recommendation-service",
  "version": "3.0.0",
  "private": true,
  "description": "AV3 Cinebridge - refatoração estrutural (Adapter, Composite e Decorator) integrada à base AV1/AV2",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "demo": "tsx src/demo-av3.ts",
    "demo:av2": "tsx src/demo.ts",
    "start": "node dist/server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "jest": "^30.1.3",
    "prisma": "^6.16.2",
    "ts-jest": "^29.4.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
